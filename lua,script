-- LÓGICA DE MODOS
local function FarmLoop()
    while GameSettings.AutoFarmEnabled do
        local target = GetClosestNPC()
        if target then
            if GameSettings.TeleportToNPCs then
                -- Implementar teleporte (usando TeleportService ou manipulação de CFrames)
                -- Exemplo: Player.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame
            end
            Attack(target)
            task.wait(0.5) -- Pequeno delay entre ataques
        else
            task.wait(1) -- Espera se não houver alvos próximos
        end
        task.wait(0.1) -- Pequeno delay no loop para não travar
    end
end

local function PvPLoop()
    while GameSettings.PvPEnabled do
        local target = GetClosestPlayer()
        if target then
            Attack(target)
            task.wait(0.5)
        else
            task.wait(1)
        end
        task.wait(0.1)
    end
end

-- LÓGICA DE ATAQUE TELEGUIDADO E CAMERA LOCK
local function ApplyCameraLock(target)
    if GameSettings.CameraLockEnabled and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local camera = game.Workspace.CurrentCamera
        local targetRootPart = target.Character.HumanoidRootPart
        local lookVector = (targetRootPart.Position - HumanoidRootPart.Position).Unit
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + lookVector)
    end
end

local function ApplyGuidedAttack(target)
    if GameSettings.GuidedAttackEnabled and target then
        -- Lógica para ajustar a mira ou o uso de skills para acertar o alvo
        -- Pode envolver predizer o movimento do alvo
        Attack(target) -- Chama a função de ataque com o alvo
    end
end

