-- FUNÇÕES DE UTILITÁRIO
local function GetClosestNPC()
    local closestNPC = nil
    local minDistance = math.huge

    for _, npc in ipairs(game.Workspace.NPCs:GetChildren()) do -- Supondo que NPCs estejam em Workspace.NPCs
        if npc:IsA("Model") and npc.Humanoid and npc.Humanoid.Health > 0 then
            local npcRootPart = npc:FindFirstChild("HumanoidRootPart")
            if npcRootPart then
                local distance = (HumanoidRootPart.Position - npcRootPart.Position).Magnitude
                if distance < minDistance and distance <= GameSettings.AttackRange then
                    -- Filtros adicionais (nome, nível)
                    if (GameSettings.NPCNameFilter == "" or npc.Name:match(GameSettings.NPCNameFilter)) and
                       (npc.Level <= GameSettings.MaxLevelNPC and npc.Level >= GameSettings.MinLevelNPC) then
                        minDistance = distance
                        closestNPC = npc
                    end
                end
            end
        end
    end
    return closestNPC
end

local function GetClosestPlayer()
    local closestPlayer = nil
    local minDistance = math.huge

    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player ~= Player and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local playerRootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if playerRootPart then
                local distance = (HumanoidRootPart.Position - playerRootPart.Position).Magnitude
                if distance < minDistance and distance <= GameSettings.AttackRange then
                    -- Filtros adicionais (nome, time)
                    if (GameSettings.PlayerNameFilter == "" or player.Name:match(GameSettings.PlayerNameFilter)) and
                       (not table.find(GameSettings.PlayerTeamsToAttack, player.Team.Name)) then
                        minDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function MoveTo(target)
    -- Implementa movimento suave para o alvo
    Services.TweenService:Create(HumanoidRootPart, TweenInfo.new(0.2), {CFrame = CFrame.lookAt(HumanoidRootPart.Position, target.Position)}):Play()
    Humanoid:MoveTo(target.Position)
end

local function Attack(target)
    -- Lógica para usar habilidades
    if target then
        local rootPart = target.Character.HumanoidRootPart
        if rootPart then
            MoveTo(rootPart) -- Move para perto do alvo
            -- Exemplo: usar a primeira skill
            local skills = Services.ReplicatedStorage.Skills -- Caminho comum para skills
            if skills then
                local skill1 = skills[GameSettings.SelectedSkill]
                if skill1 then
                    Services.ReplicatedStorage.DefaultChat.OnChat {
                        Text = "/skills " .. GameSettings.SelectedSkill,
                        Sender = Player.Name
                    }
                    -- Precisa de um delay ou lógica para garantir que a skill foi executada
                    task.wait(0.5)
                end
            end
        end
    end
end

